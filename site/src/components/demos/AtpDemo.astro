---
import DemoFrame from './DemoFrame.astro';
const times = [500, 1000, 1100, 1100, 1100, 1000, 1000, 2800];
const W = 112;
const H = 40;
/** Each node: position, label, and the step it starts running and finishes. */
const nodes = [
  { id: 'N1', label: 'Schema', x: 18, y: 140, run: 1, done: 2 },
  { id: 'N2', label: 'API', x: 160, y: 70, run: 2, done: 3 },
  { id: 'N3', label: 'Database', x: 160, y: 210, run: 2, done: 4 },
  { id: 'N4', label: 'List view', x: 302, y: 30, run: 3, done: 4 },
  { id: 'N5', label: 'Edit form', x: 302, y: 140, run: 4, done: 5 },
  { id: 'N7', label: 'Docs', x: 302, y: 250, run: 3, done: 4 },
  { id: 'N6', label: 'Tests', x: 444, y: 90, run: 5, done: 6 },
  { id: 'N8', label: 'Ship it', x: 586, y: 140, run: 6, done: 7 },
];
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges = [
  ['N1', 'N2'],
  ['N1', 'N3'],
  ['N2', 'N4'],
  ['N2', 'N5'],
  ['N3', 'N5'],
  ['N2', 'N7'],
  ['N4', 'N6'],
  ['N5', 'N6'],
  ['N6', 'N8'],
  ['N7', 'N8'],
].map(([a, b]) => {
  const s = byId[a];
  const t = byId[b];
  const x1 = s.x + W;
  const y1 = s.y + H / 2;
  const x2 = t.x;
  const y2 = t.y + H / 2;
  const mx = (x1 + x2) / 2;
  return { d: `M${x1} ${y1}C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`, seq: `0:pending,${t.run}:running,${t.done}:done` };
});
const says = [
  '',
  'Starting with the schema.',
  'Schema’s in. Two workers on the API and the database.',
  'API done; the migration is taking its time.',
  '5 of 8 done. The docs landed early.',
  'The edit form is in. Tests are running.',
  'Green. Shipping it.',
  'Plan finished: 8 nodes, 8 commits.',
];
const commits = nodes
  .map((n) => n.done)
  .sort((a, b) => a - b)
  .reduce<Record<number, number>>((acc, step) => ({ ...acc, [step]: (acc[step] ?? 0) + 1 }), {});
let total = 0;
const commitSeq = ['0:0', ...Object.entries(commits).map(([step, n]) => `${step}:${(total += n)}`)].join(',');
---

<DemoFrame
  title="pi-gna · ATP"
  times={times}
  label="An ATP plan runs as a graph: worker chats take ready nodes in parallel, each finished node is committed, and the orchestrator reports."
>
  <div class="top">
    <b>web-v2.atp.json</b>
    <span class="chip">⑂ atp/web-v2 worktree</span>
    <span class="commits">commits <i data-seq={commitSeq}></i></span>
  </div>
  <div class="graph">
    <svg class="edges" viewBox="0 0 720 300">
      {edges.map((e) => <path d={e.d} data-seq={e.seq} />)}
    </svg>
    {
      nodes.map((n) => (
        <div class="node" style={`left:${n.x}px;top:${n.y}px`} data-seq={`0:pending,${n.run}:running,${n.done}:done`}>
          <span class="id">{n.id}</span>
          <span class="nl">{n.label}</span>
          <span class="st" />
        </div>
      ))
    }
  </div>
  <div class="orch">
    <span class="who">Orchestrator</span>
    <span class="says">
      {
        says.map((text, i) =>
          text ? (
            <span data-at={i} data-off={i + 1}>
              {text}
            </span>
          ) : null,
        )
      }
    </span>
  </div>
</DemoFrame>

<style>
  .top {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 46px;
    padding: 0 18px;
    border-bottom: 1px solid var(--hair);
    font-size: 13px;
  }

  .commits {
    margin-left: auto;
    color: var(--muted);
    font-size: 12px;
  }

  .commits i {
    font-style: normal;
    color: var(--fg);
    font-weight: 700;
  }

  .commits i::after {
    content: attr(data-s);
  }

  .graph {
    position: absolute;
    left: 0;
    right: 0;
    top: 62px;
    height: 300px;
    background-image: radial-gradient(#2c2c32 1px, transparent 1.4px);
    background-size: 18px 18px;
  }

  .edges {
    position: absolute;
    inset: 0;
    width: 720px;
    height: 300px;
    overflow: visible;
  }

  .edges path {
    fill: none;
    stroke: #3a3a42;
    stroke-width: 2;
    transition: stroke 0.4s;
  }

  .edges path[data-s='running'] {
    stroke: #e5c07b;
    stroke-dasharray: 6 6;
    animation: flow 0.6s linear infinite;
  }

  .edges path[data-s='done'] {
    stroke: rgb(95 211 141 / 0.6);
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -12;
    }
  }

  .node {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 7px;
    width: 112px;
    height: 40px;
    padding: 0 9px;
    border: 1.5px dashed #44444c;
    border-radius: 10px;
    background: var(--panel);
    color: var(--muted);
    font-size: 11.5px;
    transition:
      border-color 0.4s,
      background-color 0.4s,
      color 0.4s,
      box-shadow 0.4s,
      transform 0.5s var(--spring);
  }

  .id {
    color: var(--faint);
    font-weight: 700;
    font-size: 10px;
  }

  .nl {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .st {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: #44444c;
  }

  .node[data-s='running'] {
    border: 1.5px solid #e5c07b;
    color: var(--fg);
    transform: scale(1.06);
    animation: glow 1.2s ease-in-out infinite;
  }

  .node[data-s='running'] .st {
    background: #e5c07b;
  }

  .node[data-s='done'] {
    border: 1.5px solid rgb(95 211 141 / 0.55);
    background: #1f2a24;
    color: var(--fg);
  }

  .node[data-s='done'] .st {
    background: var(--ok);
  }

  @keyframes glow {
    50% {
      box-shadow: 0 0 0 5px rgb(229 192 123 / 0.18), 0 0 22px rgb(229 192 123 / 0.35);
    }
  }

  .orch {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 46px;
    padding: 0 14px;
    border: 1px solid var(--hair);
    border-radius: 14px;
    background: var(--raised);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.35);
  }

  .who {
    padding: 2px 8px;
    border-radius: 6px;
    background: rgb(229 192 123 / 0.18);
    color: #f0d49c;
    font-size: 11px;
    font-weight: 700;
  }

  .says {
    display: grid;
    flex: 1;
  }

  .says > span {
    grid-area: 1 / 1;
    transition:
      opacity 0.15s,
      transform 0.4s var(--spring);
  }

  .says > span:global(.on) {
    transition-delay: 0.15s;
  }
</style>
