---
/** pi-gna's sidebar, with chat titles from the app's own screenshot. */
interface Props {
  current?: string;
  /** data-seq for the current chat's status mark. */
  mark?: string;
}
const { current = 'make the 🤌 3% more italian', mark = '0:done' } = Astro.props;
const projects = [
  { name: 'pi-gna', chats: ['make the 🤌 3% more italian', 'dark mode, but golden hour', 'remove the chips nobody clicks'] },
  { name: 'kilo', chats: ['cut it to 999 lines, no deps', 'explain it like a 2009 blog post'] },
  { name: 'were-so-back', chats: ['it’s so over → we’re so back'] },
];
---

<aside class="side">
  <div class="newchat">
    <svg viewBox="0 0 24 24" class="ico"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
    New chat
  </div>
  <div class="label">Projects</div>
  {
    projects.map((p) => (
      <>
        <div class="proj">
          <svg viewBox="0 0 24 24" class="ico">
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          </svg>
          {p.name}
        </div>
        {p.chats.map((c) => (
          <div class:list={['row', { cur: c === current }]}>
            <span class="t">{c}</span>
            {c === current && <span class="mark" data-seq={mark} />}
          </div>
        ))}
      </>
    ))
  }
</aside>

<style>
  .ico {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.8;
  }

  .t {
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
