---
/** Every feature as a card: the first two big, the rest in fours. */
import FeatureCard from './FeatureCard.astro';
import { FEATURES } from '../data/features';
---

<div class="bento">
  {FEATURES.map((f, i) => <FeatureCard feature={f} size={i < 2 ? 'lg' : 'sm'} index={i} />)}
</div>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .bento > :global(.lg) {
    grid-column: span 2;
  }

  @media (max-width: 1080px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .bento > :global(.lg) {
      grid-column: auto;
    }
  }
</style>
