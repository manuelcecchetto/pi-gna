---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  /** The page's own title; the site name is appended unless `fullTitle` is set. */
  title: string;
  fullTitle?: boolean;
  description?: string;
  /** Name of a 1200×630 share image in public/og/ (made from src/pages/og/[slug].astro). */
  og?: string;
  ogAlt?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  fullTitle = false,
  description = SITE.description,
  og = 'home',
  ogAlt = 'Pigna, the pi-gna mascot, waving hello',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} · pi-gna`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(`/og/${og}.jpg`, SITE.url).href;
const speculation = JSON.stringify({ prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }] });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fbf5ea" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="pi-gna" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-mono" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script is:inline type="speculationrules" set:html={speculation} />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal on scroll: [data-reveal] fades in, [data-observe] only gets .is-in for its own CSS.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
      );
      for (const el of document.querySelectorAll('[data-reveal], [data-observe]')) io.observe(el);

      // Copy buttons: data-copy holds the text.
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.dataset.copied = '';
            setTimeout(() => delete button.dataset.copied, 1600);
          } catch {
            /* clipboard unavailable: the text stays selectable */
          }
        });
      }
    </script>
  </body>
</html>
