// Cloudflare Workers static assets: `pnpm run deploy` builds and uploads dist/. No Worker script runs.
// Deploying attaches pi-gna.com and its DNS record; workers.dev and preview URLs stay off so the site has one address.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-gna-site",
  "account_id": "5c89266ecae8056fc8331fa4eefe3965",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "pi-gna.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
