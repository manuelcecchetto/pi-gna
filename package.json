{
  "name": "pi-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop UI for the pi coding agent",
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "pi-studio": "./bin/pi-studio.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && node bin/pi-studio.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "lucide-react": "1.49.0",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
