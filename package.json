{
  "name": "pi-gna",
  "productName": "pi-gna",
  "version": "0.3.2",
  "private": true,
  "description": "A desktop app for the pi coding agent",
  "author": "Manuel Cecchetto",
  "license": "MIT",
  "homepage": "https://github.com/manuelcecchetto/pi-gna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuelcecchetto/pi-gna.git"
  },
  "bugs": {
    "url": "https://github.com/manuelcecchetto/pi-gna/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "pi-gna": "./bin/pi-gna.mjs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && node bin/pi-gna.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "node scripts/build-computer-use.mjs && electron-vite build && electron-builder --mac --publish never",
    "build:computer-use": "node scripts/build-computer-use.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "release": "node scripts/release.mjs",
    "verify:responsive": "node scripts/verify-responsive-browser.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.16",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.49.0",
    "marked": "18.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "pi": {
    "extensions": [
      "./resources/pigna-flag.ts"
    ]
  },
  "packageManager": "pnpm@10.34.3"
}
