{
  "name": "pi-gna",
  "productName": "pi-gna",
  "version": "0.6.9",
  "private": true,
  "description": "A desktop app for the pi coding agent",
  "author": "Manuel Cecchetto",
  "license": "MIT",
  "homepage": "https://github.com/manuelcecchetto/pi-gna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manuelcecchetto/pi-gna.git"
  },
  "bugs": {
    "url": "https://github.com/manuelcecchetto/pi-gna/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "main": "./out/main/index.js",
  "bin": {
    "pi-gna": "./bin/pi-gna.mjs"
  },
  "scripts": {
    "dev": "vite build -c vite.preview.config.ts && electron-vite dev",
    "dev:preview": "vite build --watch -c vite.preview.config.ts",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && node bin/pi-gna.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "node scripts/build-computer-use.mjs && node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "build:computer-use": "node scripts/build-computer-use.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dmg-background": "electron scripts/make-dmg-background.mjs",
    "icon:mobile": "node scripts/make-mobile-icons.mjs",
    "dev:mobile": "vite build --watch -c vite.mobile.config.ts",
    "release": "node scripts/release.mjs",
    "verify:responsive": "node scripts/verify-responsive-browser.mjs",
    "verify:preview": "node scripts/verify-file-preview.mjs",
    "e2e:remote": "node scripts/remote-e2e/run.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.16",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jszip": "^3.10.2",
    "marked": "18.0.14",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "pi": {
    "extensions": [
      "./resources/pigna-flag.ts"
    ]
  },
  "packageManager": "pnpm@10.34.3",
  "dependencies": {
    "@betteroffice/docx": "0.4.3",
    "@betteroffice/docx-react": "0.4.3",
    "@betteroffice/fonts": "0.4.0",
    "@betteroffice/pptx": "0.2.0",
    "@betteroffice/xlsx": "0.3.0",
    "pdfjs-dist": "6.4.299"
  }
}
